record(ai, "$(USER):IPMK101:XPOS") {
  field(DESC, "IPMK101 horizontal")
  field(SCAN, "2 second")
  field(DTYP, "stream")
  field(INP, "@bpm.proto get_IPMK101X $(PORT)")
}

record(ai, "$(USER):IPMK101:YPOS") {
  field(DESC, "IPMK101 horizontal")
  field(SCAN, "2 second")
  field(DTYP, "stream")
  field(INP, "@bpm.proto get_IPMK101Y $(PORT)")
}

